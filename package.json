{
  "name": "photostacker-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Photo Stacker \u2014 find similar photos, keep the best ones (desktop app)",
  "main": "main.js",
  "scripts": {
    "build:web": "cd web && npm ci && npm run build -- --base=./",
    "start": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dineshkota.photostacker",
    "productName": "Photo Stacker",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    }
  }
}